{
  "name": "twig-paper-reading",
  "displayName": "Twig 问枝 — Paper Reading Tree",
  "description": "读论文时把主线与追问画成树状图，点节点看知识卡片，点出处跳到原文对应页；由论文想到的点子与 AI 讨论查证，整理成灵感笔记。配套的 AI 书写规则让 Claude Code、Codex、Gemini、Copilot 边讲边记、处处标出处，读完出题检验。",
  "publisher": "linyuze",
  "version": "1.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./extension.js",
  "scripts": {
    "vscode:uninstall": "node ./uninstall.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "twig.preview",
        "title": "打开预览",
        "category": "Twig",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "twig.exportHtml",
        "title": "导出 HTML",
        "category": "Twig"
      },
      {
        "command": "twig.newTree",
        "title": "新建 Twig",
        "category": "Twig"
      },
      {
        "command": "twig.search",
        "title": "搜索文献",
        "category": "Twig",
        "icon": "$(search)"
      },
      {
        "command": "twig.newFromPdf",
        "title": "从 PDF 新建 Twig",
        "category": "Twig"
      },
      {
        "command": "twig.newBlank",
        "title": "用空白模板新建 Twig",
        "category": "Twig"
      },
      {
        "command": "twig.chooseLibrary",
        "title": "选择文献库",
        "category": "Twig",
        "icon": "$(library)"
      },
      {
        "command": "twig.refresh",
        "title": "刷新",
        "category": "Twig",
        "icon": "$(refresh)"
      },
      {
        "command": "twig.newFromPaper",
        "title": "新建 Twig",
        "category": "Twig",
        "icon": "$(add)"
      },
      {
        "command": "twig.openPaperTwig",
        "title": "打开 Twig",
        "category": "Twig"
      },
      {
        "command": "twig.newIdea",
        "title": "新建灵感笔记",
        "category": "Twig"
      },
      {
        "command": "twig.installSkill",
        "title": "安装 AI 书写规则",
        "category": "Twig"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "twig",
          "title": "Twig",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "twig": [
        {
          "id": "twig.categories",
          "name": "分类"
        },
        {
          "id": "twig.papers",
          "name": "论文"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "twig.papers",
        "contents": "在上面的“分类”里选中一个分类，这里列出其中的论文。"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "twig.search",
          "when": "view == twig.categories",
          "group": "navigation@1"
        },
        {
          "command": "twig.chooseLibrary",
          "when": "view == twig.categories",
          "group": "navigation@2"
        },
        {
          "command": "twig.refresh",
          "when": "view == twig.categories",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "twig.newFromPaper",
          "when": "view == twig.papers && viewItem == paper",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "twig.newFromPaper",
          "when": "false"
        },
        {
          "command": "twig.openPaperTwig",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "twig.preview",
          "when": "resourceFilename =~ /_(twig|idea)\\.md$/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "twig.preview",
          "when": "resourceFilename =~ /_(twig|idea)\\.md$/",
          "group": "navigation"
        },
        {
          "command": "twig.exportHtml",
          "when": "resourceFilename =~ /_(twig|idea)\\.md$/",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Twig",
      "properties": {
        "twig.installSkill": {
          "type": "boolean",
          "default": false,
          "description": "把书写规则装成 skill twig，供本机已装的 Claude Code、Codex、Gemini 和 Copilot 使用（会写入家目录下的 .claude/skills 等文件夹）。第一次启动时会询问。"
        },
        "twig.folder": {
          "type": "string",
          "default": "",
          "description": "追问图（Twig 文件）的存放文件夹，不填时为工作区下的 Twig追问整理。"
        },
        "twig.ideaFolder": {
          "type": "string",
          "default": "",
          "description": "灵感笔记的根目录，不填时为工作区下的 Twig灵感笔记，其下按主题建子文件夹。"
        },
        "twig.library": {
          "type": "string",
          "enum": ["zotero", "bibtex", "folder"],
          "enumDescriptions": ["Zotero（需要 Zotero 7 以上开着，并开放本地接口）", "一个 .bib 文件（JabRef 维护的，或 Zotero、EndNote 等导出的），路径在 twig.bibFile", "不用文献软件：放论文 PDF 的文件夹，子文件夹即分类，路径在 twig.pdfFolder"],
          "default": "zotero",
          "description": "侧栏和新建 Twig 时用哪个文献库。点侧栏的“选择文献库”会一并选好文件或文件夹，不用在这里填。"
        },
        "twig.bibFile": {
          "type": "string",
          "default": "",
          "description": "twig.library 为 bibtex 时用的 .bib 文件；相对路径按当前工作区解析。分类取 JabRef 的分组，PDF 取条目的 file 字段。"
        },
        "twig.pdfFolder": {
          "type": "string",
          "default": "论文",
          "description": "twig.library 为 folder 时放论文 PDF 的文件夹；相对路径按当前工作区解析，默认为工作区下的 论文。其下各级子文件夹即分类。"
        }
      }
    }
  },
  "icon": "icon.png",
  "keywords": [
    "论文",
    "阅读",
    "知识卡片",
    "reading",
    "paper",
    "mind map",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zhiyuelin1958/twig"
  }
}
